<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>CyDownload</AssemblyName>
    <RootNamespace>CyDownload.App</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\CyDownload.Core\CyDownload.Core.csproj" />
  </ItemGroup>

  <!-- 测试引用真实程序集，不复制源码 -->
  <ItemGroup>
    <InternalsVisibleTo Include="CyDownload.Tests" />
  </ItemGroup>

  <!--
    Microsoft.Data.Sqlite 的原生库由 SDK 落到 runtimes\win-x64\native\；
    再复制一份到输出根目录，发布时整个程序目录拷走即可（与 iDeviceInstaller 同一做法）。
  -->
  <Target Name="CopySqliteNativeToOutput" AfterTargets="Build">
    <ItemGroup>
      <SqliteNativeFiles Include="$(OutDir)runtimes\win-x64\native\e_sqlite3.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(SqliteNativeFiles)" DestinationFolder="$(OutDir)"
          SkipUnchangedFiles="true" Condition="Exists('%(SqliteNativeFiles.FullPath)')" />
    <Warning Condition="!Exists('%(SqliteNativeFiles.FullPath)')"
             Text="找不到 e_sqlite3.dll：$(OutDir)runtimes\win-x64\native\。数据库将无法打开。" />
  </Target>

</Project>
