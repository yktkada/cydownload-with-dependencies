<Window x:Class="CyDownload.App.Views.ClosureWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Closure.Title}"
        Height="520" Width="900" WindowStartupLocation="CenterOwner" FontSize="12">
    <DockPanel Margin="8">
        <DockPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
            <Button Content="{DynamicResource Closure.Export}" Padding="12,4" DockPanel.Dock="Right"
                    Click="OnExportClick" />
            <Button Content="{DynamicResource Closure.DownloadLibrary}" Padding="12,4" DockPanel.Dock="Right"
                    Margin="0,0,8,0" Click="OnDownloadLibraryClick" />
            <Button Content="{DynamicResource Closure.Close}" Padding="12,4" DockPanel.Dock="Right" Margin="0,0,8,0"
                    Click="OnCloseClick" IsCancel="True" />
            <TextBlock x:Name="SummaryText" VerticalAlignment="Center" Foreground="#333" />
        </DockPanel>

        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,6">
            <TextBlock x:Name="TargetText" FontSize="11" Foreground="#555" />
            <TextBlock x:Name="CyclesText" FontSize="11" Foreground="#B36B00" TextWrapping="Wrap"
                       Margin="0,4,0,0" />
        </StackPanel>

        <TabControl>
            <TabItem Header="{DynamicResource Closure.Download}">
                <DataGrid x:Name="DownloadGrid" AutoGenerateColumns="False" IsReadOnly="True"
                          EnableRowVirtualization="True" VirtualizingPanel.VirtualizationMode="Recycling">
                    <DataGrid.Columns>
                        <DataGridTextColumn x:Name="CdPackageId" Binding="{Binding PackageId}" Width="280" />
                        <DataGridTextColumn x:Name="CdVersion" Binding="{Binding Version}" Width="140" />
                        <DataGridTextColumn x:Name="CdSize" Binding="{Binding SizeText}" Width="90" />
                        <DataGridTextColumn x:Name="CdRepo" Binding="{Binding Repo}" Width="100" />
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
            <TabItem Header="{DynamicResource Closure.Satisfied}">
                <DataGrid x:Name="SatisfiedGrid" AutoGenerateColumns="False" IsReadOnly="True"
                          EnableRowVirtualization="True" VirtualizingPanel.VirtualizationMode="Recycling">
                    <DataGrid.Columns>
                        <DataGridTextColumn x:Name="CsName" Binding="{Binding Name}" Width="260" />
                        <DataGridTextColumn x:Name="CsVersion" Binding="{Binding Version}" Width="140" />
                        <DataGridTextColumn x:Name="CsSource" Binding="{Binding Source}" Width="120" />
                        <DataGridTextColumn x:Name="CsParent" Binding="{Binding Parent}" Width="240" />
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
            <TabItem Header="{DynamicResource Closure.Unresolved}">
                <DataGrid x:Name="UnresolvedGrid" AutoGenerateColumns="False" IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn x:Name="CuText" Binding="{Binding Text}" Width="320" />
                        <DataGridTextColumn x:Name="CuReason" Binding="{Binding Reason}" Width="*" />
                        <DataGridTextColumn x:Name="CuParent" Binding="{Binding Parent}" Width="220" />
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>



