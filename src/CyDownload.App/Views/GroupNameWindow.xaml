<Window x:Class="CyDownload.App.Views.GroupNameWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Height="170" Width="380" WindowStartupLocation="CenterOwner" FontSize="12"
        ResizeMode="NoResize">
    <DockPanel Margin="14">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="{DynamicResource Group.Save}" Padding="16,4" IsDefault="True" Margin="0,0,8,0"
                    Click="OnOkClick" />
            <Button Content="{DynamicResource Group.Cancel}" Padding="16,4" IsCancel="True" Click="OnCancelClick" />
        </StackPanel>

        <TextBlock x:Name="PromptText" DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,0,0,8" />
        <TextBox x:Name="NameBox" Height="24" VerticalContentAlignment="Center" />
    </DockPanel>
</Window>
