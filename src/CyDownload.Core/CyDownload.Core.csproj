<Project Sdk="Microsoft.NET.Sdk">

  <!--
    纯逻辑层：不引用 WPF、不引用 Windows 桌面框架，可在任何宿主里单测。
    NuGet：Microsoft.Data.Sqlite（存档库）+ SharpCompress（bz2 / xz / tar / ar）。
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>CyDownload.Core</AssemblyName>
    <RootNamespace>CyDownload.Core</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Cydia 索引元数据：单文件、无服务、可离线随存档走 -->
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.14" />
    <!-- 实测三源索引只提供 .bz2（.NET 无内置 bz2）；deb 内部还需要 ar / tar / xz -->
    <PackageReference Include="SharpCompress" Version="0.50.8" />
  </ItemGroup>

  <!-- 测试引用真实程序集，不复制源码 -->
  <ItemGroup>
    <InternalsVisibleTo Include="CyDownload.Tests" />
  </ItemGroup>

</Project>
